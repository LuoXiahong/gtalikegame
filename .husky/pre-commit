#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

CHANGED=$(git diff --cached --name-only | grep -E "CityBuilder3D|FacadeGenerator|VehicleModelFactory|NPCModelFactory|RenderSystem3D|RetroFilm|PropFactory|screenshotScenarios")

if [ -n "$CHANGED" ]; then
  echo "Visual files changed. Running screenshots generation..."
  npm run screenshots
  git add docs/screenshots/*.png
fi
